.program p_3v3_rst_gp21
.side_set 3

public entry:
    set pins, 0        side 0b001
    pull block         side 0b001
    mov y, osr         side 0b001
    pull block         side 0b001
    mov x, osr         side 0b001
    pull block         side 0b001

rst_loop:
    jmp y-- rst_loop   side 0b001

    mov y, osr         side 0b001

    set pins, 1        side 0b010
poffset:
    jmp x-- poffset    side 0b010

pwidth:
    jmp y-- pwidth     side 0b110

    irq 0              side 0b010

loop:
    jmp loop           side 0b010
